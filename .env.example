# 이 파일을 복사해 .env를 만들고 값을 채운다. .env는 커밋하지 않는다 (.gitignore에 있음)

# OpenAI API 키 (https://platform.openai.com/api-keys). 비워 두면 규칙으로만 해석하고 음성 인식은 못 씀
OPENAI_API_KEY=
# 의도 파악 모델 (gpt-4o-mini는 "다음 주 금요일" 같은 날짜 계산을 자주 틀려서 gpt-4.1-mini)
# gpt-5 계열은 temperature 설정을 받지 않아 지금 코드로는 실패하고 규칙으로만 처리된다
OPENAI_MODEL=gpt-4.1-mini
# 음성 인식 모델
STT_MODEL=whisper-1

# 백엔드(Mr.World API) 주소. 투어 정보를 여기서만 받는다 (못 받으면 503)
BACKEND_BASE_URL=http://localhost:8080
# 투어 정보를 다시 받기까지 초
CATALOG_TTL_SEC=300

# 브라우저에서 AI 서버를 직접 부르는 프론트 주소 (쉼표로 여러 개). nginx로 같은 주소에서 부르면 필요 없음
CORS_ORIGINS=http://localhost:5173
